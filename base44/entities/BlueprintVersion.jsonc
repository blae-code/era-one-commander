{
  "name": "BlueprintVersion",
  "type": "object",
  "properties": {
    "blueprint_id": {
      "type": "string",
      "description": "Id of the parent Blueprint"
    },
    "version": {
      "type": "integer",
      "description": "Sequential version number, starting at 1"
    },
    "name": {
      "type": "string"
    },
    "note": {
      "type": "string",
      "description": "Optional annotation (e.g. 'Reverted to v2')"
    },
    "hull_id": {
      "type": "string"
    },
    "hull_name": {
      "type": "string"
    },
    "placements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "component_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "x": {
            "type": "integer"
          },
          "y": {
            "type": "integer"
          },
          "w": {
            "type": "integer"
          },
          "h": {
            "type": "integer"
          }
        }
      }
    },
    "stats": {
      "type": "object",
      "properties": {
        "mass": {
          "type": "number"
        },
        "hp": {
          "type": "number"
        },
        "dps": {
          "type": "number"
        },
        "thrust": {
          "type": "number"
        },
        "twr": {
          "type": "number"
        },
        "power_gen": {
          "type": "number"
        },
        "power_use": {
          "type": "number"
        },
        "shield": {
          "type": "number"
        },
        "cargo": {
          "type": "number"
        }
      }
    }
  },
  "required": [
    "blueprint_id",
    "version"
  ]
}