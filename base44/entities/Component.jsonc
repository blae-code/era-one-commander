{
  "name": "Component",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "weapon",
        "engine",
        "reactor",
        "shield",
        "module"
      ]
    },
    "subtype": {
      "type": "string"
    },
    "tier": {
      "type": "integer",
      "default": 1
    },
    "grid_w": {
      "type": "integer",
      "default": 1
    },
    "grid_h": {
      "type": "integer",
      "default": 1
    },
    "mass": {
      "type": "number"
    },
    "power": {
      "type": "number",
      "description": "Net power. Positive = generates, negative = consumes"
    },
    "hp": {
      "type": "number"
    },
    "dps": {
      "type": "number"
    },
    "range": {
      "type": "number"
    },
    "fire_rate": {
      "type": "number"
    },
    "damage_type": {
      "type": "string"
    },
    "thrust": {
      "type": "number"
    },
    "shield_hp": {
      "type": "number"
    },
    "shield_regen": {
      "type": "number"
    },
    "cargo": {
      "type": "number"
    },
    "manufacturer": {
      "type": "string"
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "category"
  ]
}