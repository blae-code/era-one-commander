{
  "name": "Asteroid",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string",
      "description": "Era One internal identifier (e.g. TUR.002, CMX_FRI3, R.U.FRS1) — the join key across all entities and localization"
    },
    "name": {
      "type": "string",
      "description": "Display name (English localization; falls back to the asset's internal name)"
    },
    "asset_name": {
      "type": "string",
      "description": "Unity asset name inside the game bundle"
    },
    "info": {
      "type": "string",
      "description": "Short role text shown in-game (e.g. 'Anti-light armor')"
    },
    "description": {
      "type": "string",
      "description": "In-game description (rich-text tags stripped)"
    },
    "restriction": {
      "type": "number"
    },
    "work_in_progress": {
      "type": "boolean"
    },
    "is_work_in_progress": {
      "type": "number"
    },
    "base_signature_noise": {
      "type": "number"
    },
    "use_pool": {
      "type": "number"
    },
    "use_pool_defaults": {
      "type": "number"
    },
    "pool_max_size": {
      "type": "number"
    },
    "pool_init_capacity": {
      "type": "number"
    },
    "disable_entity_shake": {
      "type": "number"
    },
    "construction_special_event": {
      "type": "number"
    },
    "destruction_special_event": {
      "type": "number"
    },
    "experience_reward": {
      "type": "number"
    },
    "under_attack_special_event": {
      "type": "number"
    },
    "mass": {
      "type": "number"
    },
    "full": {
      "type": "object",
      "description": "Complete decoded game record (all fields; PPtrs -> game_ids, Fix64 -> float, Odin dictionaries decoded). Enum-valued fields are raw ints here; the curated columns carry the names."
    },
    "game_version": {
      "type": "string",
      "description": "Era One version the record was extracted from"
    },
    "game_build": {
      "type": "string",
      "description": "Steam buildid the record was extracted from"
    }
  },
  "required": [
    "game_id"
  ],
  "description": "Era One Asteroid records extracted from the game files (see era-one-data). Extracted from game 0.12.2 build 24615926."
}
