      "type": "string",
      "enum": [
        "CMX",
        "PIR"
      ]
    },
    "time_to_upgrade": {
      "type": "number"
    },
    "research_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fire_event": {
      "type": "boolean"
    },
    "game_version": {
      "type": "string",
      "description": "Era One version the record was extracted from"
    },
    "game_build": {
      "type": "string",
      "description": "Steam buildid the record was extracted from"
    }
  },
  "required": [
