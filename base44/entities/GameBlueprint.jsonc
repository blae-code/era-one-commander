{
  "name": "GameBlueprint",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string",
      "description": "Era One internal identifier (e.g. TUR.002, CMX_FRI3, R.U.FRS1) — the join key across all entities and localization"
    },
    "name": {
      "type": "string",
      "description": "Display name (English localization; falls back to the asset's internal name)"
    },
    "source": {
      "type": "string",
      "enum": [
        "player",
        "shipped"
      ]
    },
    "file": {
      "type": "string"
    },
    "folder": {
      "type": "string"
    },
    "era_one_version": {
      "type": "string"
    },
    "used_by_ai": {
      "type": "boolean"
    },
    "part_count": {
      "type": "number"
    },
    "unresolved_parts": {
      "type": "number"
    },
    "cost_resources": {
      "type": "number",
      "description": "Build cost in resource units (RU)"
    },
    "cost_population": {
      "type": "number",
      "description": "Crew required"
    },
    "cost_energy": {
      "type": "number",
      "description": "Energy required"
    },
    "construction_time": {
      "type": "number",
      "description": "Build time (s)"
    },
    "required_research": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Research game_ids required"
    },
    "modules": {
      "type": "object",
      "description": "Module game_id -> count"
    },
    "sum_module_cost_resources": {
      "type": "number"
    },
    "sum_module_cost_population": {
      "type": "number"
    },
    "sum_module_max_health": {
      "type": "number"
    },
    "weapon_modules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "root_part": {
      "type": "object"
    },
    "command_part": {
      "type": "object"
    },
    "game_version": {
      "type": "string",
      "description": "Era One version the record was extracted from"
    },
    "game_build": {
      "type": "string",
      "description": "Steam buildid the record was extracted from"
    }
  },
  "required": [
    "game_id"
  ],
  "description": "Era One GameBlueprint records extracted from the game files (see era-one-data). Extracted from game 0.12.2 build 24615926."
