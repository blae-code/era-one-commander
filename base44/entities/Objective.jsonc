{
  "name": "Objective",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string",
      "description": "Era One internal identifier (e.g. TUR.002, CMX_FRI3, R.U.FRS1) — the join key across all entities and localization"
    },
    "name": {
      "type": "string",
      "description": "Display name (English localization; falls back to the asset's internal name)"
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "In-game description (rich-text tags stripped)"
    },
    "assigned_message": {
      "type": "string"
    },
    "completed_message": {
      "type": "string"
    },
    "failed_message": {
      "type": "string"
    },
    "is_challenge": {
      "type": "boolean"
    },
    "can_fail": {
      "type": "boolean"
    },
    "lose_on_fail": {
      "type": "boolean"
    },
    "time_to_complete_before_fail": {
      "type": "number"
    },
    "resources_target": {
      "type": "number"
    },
    "enemies_to_kill": {
      "type": "number"
    },
    "resource_reward": {
      "type": "number"
    },
    "completion_condition_raw": {
      "type": "number"
    },
    "game_hint": {
      "type": "string"
    },
    "speaking_actor": {
      "type": "string"
    },
    "assigned_delay": {
      "type": "number"
    },
    "completed_delay": {
      "type": "number"
    },
    "full": {
      "type": "object",
      "description": "Complete decoded game record (all fields; PPtrs -> game_ids, Fix64 -> float, Odin dictionaries decoded). Enum-valued fields are raw ints here; the curated columns carry the names."
    },
    "game_version": {
      "type": "string",
      "description": "Era One version the record was extracted from"
    },
    "game_build": {
      "type": "string",
      "description": "Steam buildid the record was extracted from"
    }
  },
  "required": [
    "game_id"
  ],
  "description": "Era One Objective records extracted from the game files (see era-one-data). Extracted from game 0.12.2 build 24615926."
}
