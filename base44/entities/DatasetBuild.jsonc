{
  "name": "DatasetBuild",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string",
      "description": "Era One internal identifier (e.g. TUR.002, CMX_FRI3, R.U.FRS1) — the join key across all entities and localization"
    },
    "name": {
      "type": "string",
      "description": "Display name (English localization; falls back to the asset's internal name)"
    },
    "game_version": {
      "type": "string",
      "description": "Era One version the record was extracted from"
    },
    "buildid": {
      "type": "string"
    },
    "catalog_hash": {
      "type": "string"
    },
    "generated_utc": {
      "type": "string"
    },
    "unity_version": {
      "type": "string"
    },
    "changes": {
      "type": "number"
    },
    "row_counts": {
      "type": "object"
    },
    "game_build": {
      "type": "string",
      "description": "Steam buildid the record was extracted from"
    }
  },
  "required": [
    "game_id"
  ],
  "description": "Era One DatasetBuild records extracted from the game files (see era-one-data). Extracted from game 0.12.2 build 24615926."
}
