{
  "name": "Weapon",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string",
      "description": "Era One internal identifier (e.g. TUR.002, CMX_FRI3, R.U.FRS1) — the join key across all entities and localization"
    },
    "name": {
      "type": "string",
      "description": "Display name (English localization; falls back to the asset's internal name)"
    },
    "asset_name": {
      "type": "string",
      "description": "Unity asset name inside the game bundle"
    },
    "info": {
      "type": "string",
      "description": "Short role text shown in-game (e.g. 'Anti-light armor')"
    },
    "description": {
      "type": "string",
      "description": "In-game description (rich-text tags stripped)"
    },
    "work_in_progress": {
      "type": "boolean"
    },
    "weapon_type": {
      "type": "string",
      "enum": [
        "EMP",
        "LongRangeTorpedo",
        "Missile",
        "NuclearBomb",
        "SelfDestruct",
        "Standard",
        "SubWeapon"
      ]
    },
    "implementation": {
      "type": "string",
      "enum": [
        "AreaOfEffect",
        "Projectile",
        "Raycast",
        "SelfDestructSystem"
      ]
    },
    "dps": {
      "type": "number",
      "description": "Damage per second (game-computed)"
    },
    "additional_dps": {
      "type": "number"
    },
    "range": {
      "type": "number",
      "description": "Weapon range"
    },
    "hp_change": {
      "type": "number",
      "description": "Hull damage per hit"
    },
    "shield_change": {
      "type": "number",
      "description": "Shield damage per hit"
    },
    "electrical_change": {
      "type": "number"
    },
    "armor_penetration": {
      "type": "number",
      "description": "Armor penetration 0..1"
    },
    "shield_to_hp_carry_over": {
      "type": "number"
    },
    "class_damage_multipliers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entity_class": {
            "type": "string"
          },
          "multiplier": {
            "type": "number"
          }
        }
      }
    },
    "rate_of_fire": {
      "type": "number",
      "description": "Shots per second"
    },
    "burst_amount": {
      "type": "number"
    },
    "burst_interval": {
      "type": "number"
    },
    "burst_spread": {
      "type": "number"
    },
    "requires_reload": {
      "type": "boolean"
    },
    "reload_time": {
      "type": "number"
    },
    "auto_reload": {
      "type": "boolean"
    },
    "requires_precharge": {
      "type": "boolean"
    },
    "precharge_duration": {
      "type": "number"
    },
    "single_shot": {
      "type": "boolean"
    },
    "heal_target": {
      "type": "boolean"
    },
    "bullet_speed": {
      "type": "number"
    },
    "bullet_lifetime": {
      "type": "number"
    },
    "bullets_follow_target": {
      "type": "boolean"
    },
    "tracking_speed": {
      "type": "number"
    },
    "acceleration": {
      "type": "number"
    },
    "max_speed": {
      "type": "number"
    },
    "deal_area_damage": {
      "type": "boolean"
    },
    "area_radius": {
      "type": "number"
    },
    "area_damage": {
      "type": "number"
    },
    "area_damage_friendly_fire": {
      "type": "boolean"
    },
    "time_area_active": {
      "type": "number"
    },
    "splash_radius": {
      "type": "number"
    },
    "total_explosion_radius": {
      "type": "number"
    },
    "inner_explosion_radius": {
      "type": "number"
    },
    "drop_off_hp_change": {
      "type": "number"
    },
    "fire_correction_cone_angle": {
      "type": "number"
    },
    "applied_status_on_hit": {
      "type": "string",
      "enum": [
        "OnFire"
      ]
    },
    "status_duration": {
      "type": "number"
    },
    "friendly_fire_multiplier": {
      "type": "number"
    },
    "scuttle_multiplier": {
      "type": "number"
    },
    "detection_range": {
      "type": "number"
    },
    "mine_arming_time": {
      "type": "number"
    },
    "max_minefield_count": {
      "type": "number"
    },
    "frag_detonation_weapon": {
      "type": "string"
    },
    "cost_resources": {
      "type": "number",
      "description": "Build cost in resource units (RU)"
    },
    "construction_time": {
      "type": "number",
      "description": "Build time (s)"
    },
    "required_research": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Research game_ids required"
    },
    "show_in_ui": {
      "type": "boolean"
    },
    "game_version": {
      "type": "string",
      "description": "Era One version the record was extracted from"
    },
    "game_build": {
      "type": "string",
      "description": "Steam buildid the record was extracted from"
    }
  },
  "required": [
    "game_id"
  ],
  "description": "Era One Weapon records extracted from the game files (see era-one-data). Extracted from game 0.12.2 build 24615926."
}
