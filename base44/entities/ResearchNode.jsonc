{
  "name": "ResearchNode",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string",
      "description": "Era One internal identifier (e.g. TUR.002, CMX_FRI3, R.U.FRS1) — the join key across all entities and localization"
    },
    "name": {
      "type": "string",
      "description": "Display name (English localization; falls back to the asset's internal name)"
    },
    "asset_name": {
      "type": "string",
      "description": "Unity asset name inside the game bundle"
    },
    "info": {
      "type": "string",
      "description": "Short role text shown in-game (e.g. 'Anti-light armor')"
    },
    "description": {
      "type": "string",
      "description": "In-game description (rich-text tags stripped)"
    },
    "work_in_progress": {
      "type": "boolean"
    },
    "research_type": {
      "type": "string",
      "enum": [
        "Ability",
        "Technology",
        "Tier",
        "Upgrade"
      ]
    },
    "implementation_mode": {
      "type": "string",
      "enum": [
        "ModuleClass",
        "SingleModuleSubType",
        "SingleModuleType",
        "SingleUnitType",
        "TeamWide",
        "UnitClass"
      ]
    },
    "tier": {
      "type": "number",
      "description": "Tech tier"
    },
    "tier_number": {
      "type": "number"
    },
    "score": {
      "type": "number",
      "description": "Match score value"
    },
    "automatic": {
      "type": "boolean"
    },
    "cost_resources": {
      "type": "number",
      "description": "Build cost in resource units (RU)"
    },
    "cost_energy": {
      "type": "number",
      "description": "Energy required"
    },
    "cost_research": {
      "type": "number"
    },
    "cost_population": {
      "type": "number",
      "description": "Crew required"
    },
    "construction_time": {
      "type": "number",
      "description": "Build time (s)"
    },
    "required_research_score": {
      "type": "number"
    },
    "research_score_award_override": {
      "type": "number"
    },
    "required_nodes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "other_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "child_nodes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unit_class_affected": {
      "type": "string"
    },
    "module_class_affected": {
      "type": "string"
    },
    "units_affected": {
      "type": "string"
    },
    "module_types_affected": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "module_sub_type_affected": {
      "type": "string"
    },
    "static_bonus_resource_capacity": {
      "type": "number"
    },
    "static_bonus_energy_capacity": {
      "type": "number"
    },
    "static_bonus_population_capacity": {
      "type": "number"
    },
    "static_bonus_research_capacity": {
      "type": "number"
    },
    "unlocks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "modifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stat": {
            "type": "string"
          },
          "operation": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "clamp": {
            "type": "boolean"
          },
          "abs": {
            "type": "boolean"
          }
        }
      },
      "description": "Stat modifiers granted (research upgrades)"
    },
    "agent_category": {
      "type": "string"
    },
    "unlocks_modules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unlocks_units": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unlocks_weapons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tree_depth": {
      "type": "number"
    },
    "tree_order": {
      "type": "number"
    },
    "full": {
      "type": "object",
      "description": "Complete decoded game record (all fields; PPtrs -> game_ids, Fix64 -> float, Odin dictionaries decoded). Enum-valued fields are raw ints here; the curated columns carry the names."
    },
    "game_version": {
      "type": "string",
      "description": "Era One version the record was extracted from"
    },
    "game_build": {
      "type": "string",
      "description": "Steam buildid the record was extracted from"
    }
  },
  "required": [
    "game_id"
  ],
  "description": "Era One ResearchNode records extracted from the game files (see era-one-data). Extracted from game 0.12.2 build 24615926."
}
