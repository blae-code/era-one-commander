// HAND-AUTHORED — not generated by era-one-data, and deliberately absent from the pipeline's
// EXPECTED manifest and ERA_ONE_ENTITIES list.
//
// Why this entity exists: gameDataStatus embeds the expected game_id set at generation time and reports
// any live-but-unexpected id as `extra` -> ok:false. Player-authored .station designs are transient (they
// get renamed, rebuilt and deleted), so writing `player:<name>` rows into the generated GameBlueprint set
// meant the first import or deletion permanently reddened the app's own health check. User data never
// enters the generated manifest; it lives here instead.
//
// Written at runtime by base44/functions/importStationFile (create:true). Never seeded, never reseeded,
// never deleted by importGameData.
{
  "name": "PlayerDesign",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string",
      "description": "player:<name> — stable key for one imported design, unique per design name"
    },
    "name": { "type": "string", "description": "Design name (from the .station file or supplied on import)" },
    "source_file": { "type": "string", "description": "Original .station filename this was decoded from" },
    "file_mtime": { "type": "string", "description": "ISO timestamp of the source file when imported, so a re-import can be detected" },
    "era_one_version": { "type": "string", "description": "Game version string recorded inside the .station file itself" },
    "part_count": { "type": "number" },
    "unresolved_parts": { "type": "number", "description": "Parts whose prefab GUID did not resolve to a Module (should be 0)" },
    "cost_resources": { "type": "number" },
    "cost_population": { "type": "number" },
    "construction_time": { "type": "number" },
    "required_research": { "type": "array", "items": { "type": "string" }, "description": "ResearchNode game_ids this design needs" },
    "modules": { "type": "object", "description": "module game_id -> count" },
    "sum_module_cost_resources": { "type": "number" },
    "sum_module_cost_population": { "type": "number" },
    "sum_module_max_health": { "type": "number" },
    "dps_vs_class": {
      "type": "object",
      "description": "Per-target-class DPS. There is deliberately no class-free dps total: summing damage across all classes at once ranks an anti-mine platform above a cruiser."
    },
    "weapon_modules": { "type": "array", "items": { "type": "string" } },
    "root_part": { "type": "number" },
    "command_part": { "type": "number" },
    "parts": { "type": "array", "description": "Decoded parts: index, guid, module_id, position, rotation, parent, connection" },
    "game_version": { "type": "string", "description": "Extraction build this was costed against" },
    "game_build": { "type": "string" },
    "imported_utc": { "type": "string" }
  },
  "required": ["game_id", "name"]
}
