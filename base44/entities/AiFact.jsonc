{
  "name": "AiFact",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string",
      "description": "Era One internal identifier (e.g. TUR.002, CMX_FRI3, R.U.FRS1) — the join key across all entities and localization"
    },
    "name": {
      "type": "string",
      "description": "Display name (English localization; falls back to the asset's internal name)"
    },
    "numeric_id": {
      "type": "number"
    },
    "category": {
      "type": "string"
    },
    "color": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "auto_generate_goal": {
      "type": "boolean"
    },
    "non_blocking": {
      "type": "boolean"
    },
    "game_version": {
      "type": "string",
      "description": "Era One version the record was extracted from"
    },
    "game_build": {
      "type": "string",
      "description": "Steam buildid the record was extracted from"
    }
  },
  "required": [
    "game_id"
  ],
  "description": "Era One AiFact records extracted from the game files (see era-one-data). Extracted from game 0.12.2 build 24615926."
}
