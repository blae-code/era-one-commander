    },
    "key": {
      "type": "string"
    },
    "text_en": {
      "type": "string"
    },
    "game_version": {
      "type": "string",
      "description": "Era One version the record was extracted from"
    },
    "game_build": {
      "type": "string",
      "description": "Steam buildid the record was extracted from"
    },
    "text_en_truncated": {
      "type": "boolean"
    }
  },
  "required": [
