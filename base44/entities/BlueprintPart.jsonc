{
  "name": "BlueprintPart",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string",
      "description": "Era One internal identifier (e.g. TUR.002, CMX_FRI3, R.U.FRS1) — the join key across all entities and localization"
    },
    "blueprint_id": {
      "type": "string"
    },
    "blueprint": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "player",
        "shipped"
      ]
    },
    "index": {
      "type": "number"
    },
    "module_id": {
      "type": "string"
    },
    "module_name": {
      "type": "string"
    },
    "position": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "rotation": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "parent_part": {
      "type": "number"
    },
    "parent_connection": {
      "type": "number"
    },
    "game_version": {
      "type": "string",
      "description": "Era One version the record was extracted from"
    },
    "game_build": {
      "type": "string",
      "description": "Steam buildid the record was extracted from"
    }
  },
  "required": [
    "game_id"
  ],
  "description": "Era One BlueprintPart records extracted from the game files (see era-one-data). Extracted from game 0.12.2 build 24615926."
}
